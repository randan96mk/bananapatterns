# Kite Connect credentials — https://developers.kite.trade/
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Optional: paste a token here instead of using the browser login (expires 06:00 IST next day)
KITE_ACCESS_TOKEN=
# Must match the redirect URL registered on the Kite developer console
KITE_REDIRECT_URL=http://localhost:8000/api/kite/callback

# Optional overrides
# BP_DB_PATH=data/bananapatterns.db
# BP_DEV=1          # uvicorn auto-reload

# Telegram alerts (optional) — create a bot with @BotFather, paste its token here, restart the backend,
# send the bot any message, then Settings -> Alerts -> Detect chat ID.
TELEGRAM_BOT_TOKEN=
# Optional: set the chat ID here instead of using Detect chat ID
TELEGRAM_CHAT_ID=

# Kite login link from Telegram (optional)
# Address Kite redirects back to; must be reachable from your phone for links to work there
# (Tailscale or cloud), e.g. https://your-mac.your-tailnet.ts.net. Default: from KITE_REDIRECT_URL.
PUBLIC_BASE_URL=
# Dashboard password: set it before the app is reachable from outside this Mac
BP_DASHBOARD_PASSWORD=

# 💰 Real trading: the Tradetron webhook auth token (orders are sent to Tradetron, never to Kite). Keep it here only.
TRADETRON_TOKEN=
